[Unit]
Description=Jetson temperature/throttle monitor (thermal capture for freeze diagnosis)
# robot-control 과 독립 — 프리즈/재시작/실패와 무관하게 "항상" 감시.
# 프리즈 직전 hot-surface-alert 가 관측됨 → 온도/스로틀 추이를 남겨 발열 상관을 포착한다.
StartLimitIntervalSec=0

[Service]
Type=simple
User=koceti
ExecStartPre=-/bin/mkdir -p /var/log/robot_control
ExecStart=/usr/bin/python3 /home/koceti/ros2_ws/tools/diag/temp_monitor.py --out /var/log/robot_control/temp_monitor.csv --hz 2
# 죽으면 즉시 되살림 (스크립트는 매 기록 fsync 라 하드컷에도 직전까지 디스크에 남음)
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
