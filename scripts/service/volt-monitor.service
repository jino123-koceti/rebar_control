[Unit]
Description=Jetson input voltage monitor (brownout capture for freeze diagnosis)
# robot-control 과 독립 — 프리즈/재시작/실패와 무관하게 "항상" 감시.
# 시스템이 켜져 있는 한 전압을 남겨, 다음 프리즈의 전원 원인을 반드시 포착한다.
StartLimitIntervalSec=0

[Service]
Type=simple
User=koceti
ExecStartPre=-/bin/mkdir -p /var/log/robot_control
ExecStart=/usr/bin/python3 /home/koceti/ros2_ws/tools/diag/volt_monitor.py --out /var/log/robot_control/volt_monitor.csv --hz 50
# 죽으면 즉시 되살림 (스크립트는 매 기록 fsync 라 하드컷에도 직전까지 디스크에 남음)
Restart=always
RestartSec=1
# 다른 부하에 밀려 샘플 놓치지 않도록 약간 우선
Nice=-5

[Install]
WantedBy=multi-user.target
